{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd Frontend && npm ci",
  "buildCommand": "cd Frontend && npm run build",
  "outputDirectory": "Frontend/dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{Frontend/**,sql/**,database/**,presentation/**,proposal/**,endpoints/uploads/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:endpoint([a-z_]+\\.php)",
      "destination": "/api/index.php?__endpoint=:endpoint"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "sin1"
  ]
}
